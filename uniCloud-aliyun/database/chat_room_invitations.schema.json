{
  "bsonType": "object",
  "required": ["room_id", "inviter_id", "invitee_id", "status"],
  "permission": {
    "read": "auth.role.indexOf('police') > -1 || auth.role.indexOf('admin') > -1",
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "入群邀请唯一ID，自动生成"
    },
    "room_id": {
      "bsonType": "string",
      "title": "群聊ID",
      "foreignKey": "chat_rooms._id"
    },
    "room_name": {
      "bsonType": "string",
      "title": "群聊名称"
    },
    "room_type": {
      "bsonType": "string",
      "title": "群聊类型",
      "enum": ["task", "department", "warning", "temp"]
    },
    "task_id": {
      "bsonType": "string",
      "title": "关联任务ID"
    },
    "dept": {
      "bsonType": "string",
      "title": "关联部门"
    },
    "inviter_id": {
      "bsonType": "string",
      "title": "邀请人 officer_id"
    },
    "inviter_name": {
      "bsonType": "string",
      "title": "邀请人姓名"
    },
    "inviter_badge_no": {
      "bsonType": "string",
      "title": "邀请人警号"
    },
    "invitee_id": {
      "bsonType": "string",
      "title": "被邀请人 officer_id"
    },
    "invitee_name": {
      "bsonType": "string",
      "title": "被邀请人姓名"
    },
    "invitee_badge_no": {
      "bsonType": "string",
      "title": "被邀请人警号"
    },
    "invite_reason": {
      "bsonType": "string",
      "title": "邀请说明",
      "maxLength": 300
    },
    "status": {
      "bsonType": "string",
      "title": "邀请状态",
      "enum": ["pending", "accepted", "declined", "expired", "cancelled", "invalid"],
      "defaultValue": "pending"
    },
    "history_policy": {
      "bsonType": "string",
      "title": "历史消息可见策略",
      "enum": ["all", "from_join"],
      "defaultValue": "from_join"
    },
    "history_visible_from": {
      "bsonType": "timestamp",
      "title": "历史消息可见起点"
    },
    "expire_time": {
      "bsonType": "timestamp",
      "title": "过期时间"
    },
    "respond_time": {
      "bsonType": "timestamp",
      "title": "处理时间"
    },
    "respond_reason": {
      "bsonType": "string",
      "title": "处理说明"
    },
    "cancelled_by": {
      "bsonType": "string",
      "title": "撤销人 officer_id"
    },
    "cancel_reason": {
      "bsonType": "string",
      "title": "撤销原因"
    },
    "create_time": {
      "bsonType": "timestamp",
      "title": "创建时间",
      "forceDefaultValue": { "$env": "now" }
    },
    "update_time": {
      "bsonType": "timestamp",
      "title": "更新时间",
      "forceDefaultValue": { "$env": "now" }
    }
  }
}
